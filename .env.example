# VERITAS AI environment configuration.
# Copy to .env and replace every value marked CHANGE_ME. Never commit .env.

# --- Application ---
VERITAS_ENV=development
VERITAS_LOG_LEVEL=INFO
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
VERITAS_JWT_SECRET=CHANGE_ME_generate_a_long_random_secret
VERITAS_ACCESS_TOKEN_MINUTES=15
VERITAS_REFRESH_TOKEN_DAYS=7
VERITAS_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
VERITAS_LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- PostgreSQL ---
POSTGRES_DB=veritas
POSTGRES_USER=veritas_owner
POSTGRES_PASSWORD=CHANGE_ME_owner_password
# Application role (non-owner, so row-level security applies to it)
VERITAS_APP_DB_USER=veritas_app
VERITAS_APP_DB_PASSWORD=CHANGE_ME_app_password
# Read-only role used by the Kiro Postgres MCP server during development
VERITAS_RO_DB_USER=veritas_readonly
VERITAS_RO_DB_PASSWORD=CHANGE_ME_readonly_password
# Owner URL: used only by Alembic migrations
VERITAS_MIGRATION_DATABASE_URL=postgresql+asyncpg://veritas_owner:CHANGE_ME_owner_password@127.0.0.1:5432/veritas
# App URL: used by the API and workers
VERITAS_DATABASE_URL=postgresql+asyncpg://veritas_app:CHANGE_ME_app_password@127.0.0.1:5432/veritas
# Read-only URL for the Kiro Postgres MCP server (plain postgres:// scheme)
VERITAS_RO_DATABASE_URL=postgresql://veritas_readonly:CHANGE_ME_readonly_password@127.0.0.1:5432/veritas

# --- Redis / Celery ---
VERITAS_REDIS_URL=redis://127.0.0.1:6379/0
VERITAS_CELERY_BROKER_URL=redis://127.0.0.1:6379/1
VERITAS_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
VERITAS_WORKER_CONCURRENCY=1

# --- Cross-document comparison ---
# Totals in one currency differing by more than this share of the highest value are reported.
VERITAS_AMOUNT_TOLERANCE=0.005
# Party names below this similarity (0..1, after removing legal suffixes) are reported.
VERITAS_NAME_SIMILARITY_THRESHOLD=0.85

# --- Evidence graph (Neo4j; derived from Postgres, optional at runtime) ---
# Compose uses bolt://neo4j:7687 inside the network; this URI is for tools on the host.
VERITAS_NEO4J_URI=bolt://127.0.0.1:7687
VERITAS_NEO4J_USER=neo4j
VERITAS_NEO4J_PASSWORD=CHANGE_ME_neo4j_password
# Separates deployments (or test runs) that share one Neo4j.
VERITAS_NEO4J_NAMESPACE=default
# Names at or above this similarity merge into one entity; lower, down to the name
# similarity threshold, they are flagged as possible duplicates.
VERITAS_ENTITY_MERGE_THRESHOLD=0.95
VERITAS_OUTBOX_MAX_ATTEMPTS=5

# --- Model provider (OpenAI-compatible; hosted or local, e.g. a Qwen2.5 server) ---
# Local Ollama example (the worker container reaches the host through host.docker.internal):
#   VERITAS_LLM_BASE_URL=http://host.docker.internal:11434/v1
#   VERITAS_LLM_MODEL=qwen2.5:7b-instruct
#   VERITAS_VLM_MODEL=qwen2.5vl:7b
#   VERITAS_LLM_TIMEOUT_SECONDS=180
# Leave the base URL empty to use only the deterministic rules extractor.
VERITAS_LLM_BASE_URL=
VERITAS_LLM_API_KEY=
VERITAS_LLM_MODEL=
VERITAS_VLM_MODEL=
VERITAS_LLM_TIMEOUT_SECONDS=60
# Comma-separated fallback model names, tried in order
VERITAS_LLM_FALLBACK_MODELS=

# --- Object storage (S3 API; SeaweedFS in Docker Compose) ---
VERITAS_STORAGE_ENDPOINT=127.0.0.1:9000
VERITAS_STORAGE_ACCESS_KEY=veritas
VERITAS_STORAGE_SECRET_KEY=CHANGE_ME_storage_secret
VERITAS_STORAGE_BUCKET=veritas-documents

# --- Upload limits ---
VERITAS_MAX_UPLOAD_MB=25
VERITAS_ZIP_MAX_ENTRIES=50
VERITAS_ZIP_MAX_TOTAL_MB=200
VERITAS_ZIP_MAX_RATIO=100
